# 

regexp=(?i).*error:
colours=bold red
count=more
======
regexp=(?i).*warning:
colours=bold yellow
count=more
======
# path names (absolute or relative)
regexp=((\.{1,2}/)+|/)[A-Za-z0-9_.\-/]+
colours=white
count=more
======

#
# ip address
#

# IPv4 address (e.g., 192.168.1.10)
regexp=([0-9]{1,3}\.){3}[0-9]{1,3}
colours=bold blue
count=more

# IPv6 address (e.g., fe80::1ff:fe23:4567:890a)
regexp=([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}
colours=bold blue
count=more

#
# date & time
#

# Time only (e.g., 17:32:45)
regexp=\b[0-9]{2}:[0-9]{2}:[0-9]{2}\b
colours=cyan
count=once

# Date & time (e.g., 2025-10-17, 17:32:45, or 2025/10/17)
regexp=\b[0-9]{4}[-/][0-9]{2}[-/][0-9]{2}\b
colours=yellow
count=once

# date
#   'Jun  3 22:44:55
regexp=\b... (\d| )\d \d\d:\d\d:\d\d\b
colours=green
count=once

