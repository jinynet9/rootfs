
#
tmpfile="$HOME/rootfs/home/config/grc/grc.bash"
[ -f "$tmpfile" ] && source "$tmpfile"

#
tmpfile="$HOME/rootfs/home/config/bat/bat.bash"
[ -f "$tmpfile" ] && source "$tmpfile"

#
# bat
#
export BAT_THEME="GitHub"

# auto-wrap
echo -e '\e[?7h'

#
# ls
#
unalias ls
ls() {
    # Flag to indicate whether '-l' option is present
    local has_l_option=false

    # Loop through all provided arguments
    for arg in "$@"; do
        # Check if argument starts with '-' and contains 'l'
        if [[ "$arg" == -* && "$arg" == *l* ]]; then
            has_l_option=true
            break
        fi
    done

    # If '-l' option exists and 'grc' is installed, use 'grc' for colorized output
    if $has_l_option && command -v grc >/dev/null 2>&1; then
        command grc --colour=auto ls "$@"
    else
        # Otherwise, run the original 'ls' command directly
        command ls -CF --color=auto --show-control-chars "$@"
    fi
}

