#!/bin/bash

# ------------------------------------------------------------------------------
# Generate cscope and ctags database from source files relative to current dir
# Allows:
#   - Specifying file patterns to include (e.g. *.c, *.h)
#   - Excluding specific files/directories
#   - Manually adding specific files
# ------------------------------------------------------------------------------

CSCOPE_FILE="cscope.files"

# File patterns to include
INCLUDE_PATTERNS=("*.c" "*.h")

# Directories or files to exclude (relative to current directory)
#EXCLUDE_PATHS=("build_dir" "./ignore_this.c")
EXCLUDE_PATHS=("build_dir")

# Specific files to include manually (even if they don't match find)
#INCLUDE_FILES=("special.c" "extra/path/to/header.h")
INCLUDE_FILES=()

# Remove old files
rm -f cscope.* tags

# Create empty cscope.files
> "$CSCOPE_FILE"


# Build exclusion expression
EXCLUDE_EXPR=()
for path in "${EXCLUDE_PATHS[@]}"; do
    EXCLUDE_EXPR+=( -path "$path" -o )
done
# Remove trailing -o
if [ ${#EXCLUDE_EXPR[@]} -gt 0 ]; then
    unset 'EXCLUDE_EXPR[${#EXCLUDE_EXPR[@]}-1]'
fi

# Build name pattern expression
NAME_EXPR=()
for pattern in "${INCLUDE_PATTERNS[@]}"; do
    NAME_EXPR+=( -name \""$pattern"\" -o )
done
unset 'NAME_EXPR[${#NAME_EXPR[@]}-1]'

# Run find
#find . \
#    \( "${EXCLUDE_EXPR[@]}" \) -prune -o \
#    \( "${NAME_EXPR[@]}" \) -type f -print >> "$CSCOPE_FILE"
#
#echo find . \( "${EXCLUDE_EXPR[@]}" \) -prune -o \( "${NAME_EXPR[@]}" \) -type f -print

FIND_CMD="find . \( ${EXCLUDE_EXPR[*]} \) -prune -o \( ${NAME_EXPR[*]} \) -type f -print"

echo "$FIND_CMD"

eval "$FIND_CMD" >> "$CSCOPE_FILE"

# Add manually included files
for file in "${INCLUDE_FILES[@]}"; do
    if [ -f "$file" ]; then
        echo "$file" >> "$CSCOPE_FILE"
    fi
done

# Remove duplicates
sort -u -o "$CSCOPE_FILE" "$CSCOPE_FILE"


# Generate tag files
ctags -L "$CSCOPE_FILE"
#ctags -L "$CSCOPE_FILE" --fields=+iaS --extra=+q -f tags

#cscope -b -q -k -i "$CSCOPE_FILE"
cscope -b -i "$CSCOPE_FILE"

echo "cscope and ctags files generated."

exit 0

################################################################################
#
#

# Build find command with exclusion rules
EXCLUDE_FIND_ARGS=()
for path in "${EXCLUDE_PATHS[@]}"; do
    EXCLUDE_FIND_ARGS+=(-path "$path" -prune -o)
done

# Add matching source files (excluding the specified paths)
for pattern in "${INCLUDE_PATTERNS[@]}"; do
    find . "${EXCLUDE_FIND_ARGS[@]}" -type f -name "$pattern" -print >> "$CSCOPE_FILE"
done

# Manually add specific files
for file in "${INCLUDE_FILES[@]}"; do
    if [ -f "$file" ]; then
        echo "$file" >> "$CSCOPE_FILE"
    fi
done

# Remove duplicates lines
sort -u -o "$CSCOPE_FILE" "$CSCOPE_FILE"

# Generate tag files
ctags -L "$CSCOPE_FILE"
#ctags -L "$CSCOPE_FILE" --fields=+iaS --extra=+q -f tags

#cscope -b -q -k -i "$CSCOPE_FILE"
cscope -b -i "$CSCOPE_FILE"

echo "cscope and ctags files generated."

